              </div>
            </div>
          </div>

          <!-- Live CI Console Output -->
          <div class="ci-console">
            <div class="console-head">
              <span>Runner Logs · Ubuntu 22.04 LTS</span>
              <span class="badge-green">Pipeline Success</span>
            </div>
            <pre class="console-output" id="ci-logs"><code>$ git checkout -qf 8f3c92a
$ pnpm run lint
  [✓] All 42 files matched formatting and type safety requirements.
$ pnpm run test:ci
  [✓] test/api/recipe.test.ts (8 passed)
  [✓] test/api/auth.test.ts (6 passed)
  [✓] test/db/prisma-relations.test.ts (4 passed)
  Total: 18 passed, 0 failed. Time: 3.12s
$ docker build -t dishly:production .
  [✓] Image built and pushed to container registry.
[SUCCESS] Application ready and serving requests on production cluster.</code></pre>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<script>
  // Tab Switcher
  const tabButtons = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
  const tabPanels = document.querySelectorAll<HTMLElement>(".tab-panel");

  tabButtons.forEach(btn => {
    btn.addEventListener("click", () => {
      const target = btn.dataset.tab;
      if (!target) return;

      tabButtons.forEach(b => {
        b.classList.remove("active");
        b.setAttribute("aria-selected", "false");
      });
      tabPanels.forEach(p => {
        p.classList.remove("active");
        p.setAttribute("hidden", "true");
      });

      btn.classList.add("active");
      btn.setAttribute("aria-selected", "true");

      const activePanel = document.getElementById(`panel-${target}`);
      if (activePanel) {
        activePanel.classList.add("active");
        activePanel.removeAttribute("hidden");
      }
    });
  });

  // Dishly Data Presets
  interface RecipeData {
    icon: string;
    title: string;
    cat: string;
    desc: string;
    time: string;
    servings: string;
    diff: string;
    cals: string;
    score: string;
    ingredients: string[];
    author: string;
    code: string;
    latency: string;
  }

  const recipesData: Record<string, RecipeData> = {
    tajine: {
      icon: "🍲",
      title: "Tajine d'Agneau aux Pruneaux",
      cat: "Traditionnel & Mijoté",
      desc: "Mijoté aux épices douces marocaines, oignons caramélisés et amandes torréfiées.",
      time: "⏱️ 35 min",
      servings: "4 pers.",
      diff: "Moyenne",
      cals: "480 kcal",
      score: "A · 92/100",
      ingredients: ["Agneau sélectionné", "Pruneaux moelleux", "Amandes grillées", "Cannelle & Safran"],
      author: "Par Kaoutar Bendidi",
      latency: "18ms",
      code: `// Sélection de données via Prisma ORM
const recipe = await prisma.recipe.findUnique({
  where: { slug: "tajine-traditionnel" },
  include: {
    ingredients: true,
    nutrients: true,
    author: { select: { name: true, role: true } }
  }
});
res.status(200).json({ success: true, data: recipe });`
    },
    quinoa: {
      icon: "🥗",
      title: "Bowl Énergie Quinoa & Avocat",
      cat: "Nutrition & Équilibre",
      desc: "Quinoa tricolore, pois chiches rôtis au paprika, avocat frais et vinaigrette tahini maison.",
      time: "⏱️ 15 min",
      servings: "2 pers.",
      diff: "Facile",
      cals: "390 kcal",
      score: "A+ · 98/100",
      ingredients: ["Quinoa tricolore", "Avocat Haas", "Pois chiches grillés", "Tahini & Citron"],
      author: "Par Kaoutar Bendidi",
      latency: "14ms",
      code: `// Filtre dynamique : Recettes express & riches en protéines
const recipes = await prisma.recipe.findMany({
  where: {
    prepTimeMinutes: { lte: 20 },
    tags: { has: "healthy" }
  },
  orderBy: { nutritionalScore: "desc" }
});
res.status(200).json({ count: recipes.length, items: recipes });`
    },
    citrus: {
      icon: "🍊",
      title: "Salade Citrus & Avocat Grillé",
      cat: "Fraîcheur & Antioxydant",
      desc: "Suprêmes d'orange sanguine et pamplemousse, jeunes pousses, pistaches et vinaigre balsamique réduit.",
      time: "⏱️ 10 min",
      servings: "1 pers.",
      diff: "Très facile",
      cals: "280 kcal",
      score: "A · 95/100",
      ingredients: ["Orange sanguine", "Pamplemousse rose", "Pousses d'épinard", "Pistaches concassées"],
      author: "Par Kaoutar Bendidi",
      latency: "12ms",
      code: `// Agrégation & Calcul des ratios nutritionnels
const analysis = await prisma.recipeNutrients.aggregate({
  where: { recipeId: "rcp_citrus_fresh" },
  _avg: { calories: true, fiberGrams: true }
});
res.status(200).json({ status: "optimized", metrics: analysis });`
    }
  };

  const presetBtns = document.querySelectorAll<HTMLButtonElement>(".preset-btn");
  const elIcon = document.getElementById("dishly-icon");
  const elTitle = document.getElementById("dishly-title");
  const elCat = document.getElementById("dishly-cat");
  const elDesc = document.getElementById("dishly-desc");
  const elTime = document.getElementById("dishly-time");
  const elServings = document.getElementById("dishly-servings");
  const elDiff = document.getElementById("dishly-diff");
  const elCals = document.getElementById("dishly-cals");
  const elScore = document.getElementById("dishly-score");
  const elIngredients = document.getElementById("dishly-ingredients");
  const elAuthor = document.getElementById("dishly-author");
  const elCode = document.getElementById("dishly-code");
  const elLatency = document.getElementById("dishly-latency");

  presetBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      const key = btn.dataset.recipe;
      if (!key || !recipesData[key]) return;
      const data = recipesData[key];

      presetBtns.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");

      if (elIcon) elIcon.textContent = data.icon;
      if (elTitle) elTitle.textContent = data.title;
      if (elCat) elCat.textContent = data.cat;
      if (elDesc) elDesc.textContent = data.desc;
      if (elTime) elTime.textContent = data.time;
      if (elServings) elServings.textContent = data.servings;
      if (elDiff) elDiff.textContent = data.diff;
      if (elCals) elCals.textContent = data.cals;
      if (elScore) elScore.textContent = data.score;
      if (elAuthor) elAuthor.textContent = data.author;
      if (elLatency) elLatency.textContent = data.latency;
      if (elCode) elCode.innerHTML = `<code>${data.code}</code>`;

      if (elIngredients) {
        elIngredients.innerHTML = data.ingredients.map(ing => `<span>${ing}</span>`).join("");
      }
    });
  });

  // Favorite Button Toggle
  const favBtn = document.getElementById("dishly-fav-btn");
  const favIcon = document.getElementById("fav-icon");
  let isFav = false;
  favBtn?.addEventListener("click", () => {
    isFav = !isFav;
    if (favIcon) favIcon.textContent = isFav ? "❤️" : "🤍";
  });

  // GENERATIVE CANVAS SIMULATION
  const canvas = document.getElementById("generative-canvas") as HTMLCanvasElement | null;
  const sliderDensity = document.getElementById("slider-density") as HTMLInputElement | null;
  const sliderSpeed = document.getElementById("slider-speed") as HTMLInputElement | null;
  const regenBtn = document.getElementById("canvas-regen-btn");

  if (canvas) {
    const ctx = canvas.getContext("2d");
    let animationFrameId: number;
    let phase = 0;
    let mouseX = canvas.width / 2;
    let mouseY = canvas.height / 2;

    canvas.addEventListener("mousemove", (e) => {
      const rect = canvas.getBoundingClientRect();
      mouseX = ((e.clientX - rect.left) / rect.width) * canvas.width;
      mouseY = ((e.clientY - rect.top) / rect.height) * canvas.height;
    });

    regenBtn?.addEventListener("click", () => {
      phase = 0;
      if (sliderDensity) sliderDensity.value = "8";
      if (sliderSpeed) sliderSpeed.value = "2";
    });

    function draw() {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const cx = canvas.width / 2;
      const cy = canvas.height / 2;
      const density = sliderDensity ? parseInt(sliderDensity.value, 10) : 8;
      const speed = sliderSpeed ? parseFloat(sliderSpeed.value) * 0.015 : 0.03;

      phase += speed;

      // Draw background ambient grid lines
      ctx.strokeStyle = "rgba(157, 109, 232, 0.08)";
      ctx.lineWidth = 1;
      for (let i = 20; i < canvas.width; i += 40) {
        ctx.beginPath();
        ctx.moveTo(i, 0);
        ctx.lineTo(i, canvas.height);
        ctx.stroke();
      }

      // Draw mathematical harmonic circles
      const rings = 3;
      for (let r = 1; r <= rings; r++) {
        const baseRadius = r * 42;
        const nodesCount = density * 2;
        const points: { x: number; y: number }[] = [];

        for (let i = 0; i < nodesCount; i++) {
          const theta = (i * 2 * Math.PI) / nodesCount;
          const wave = Math.sin(theta * density + phase * (r % 2 === 0 ? 1 : -1)) * (8 + r * 3);

          const rawX = cx + (baseRadius + wave) * Math.cos(theta);
          const rawY = cy + (baseRadius + wave) * Math.sin(theta);

          // Pointer magnetic interaction
          const distToMouse = Math.hypot(mouseX - rawX, mouseY - rawY);
          const pull = Math.max(0, 50 - distToMouse) * 0.3;
          const angleToMouse = Math.atan2(mouseY - rawY, mouseX - rawX);

          points.push({
            x: rawX + Math.cos(angleToMouse) * pull,
            y: rawY + Math.sin(angleToMouse) * pull
          });
        }

        // Connect points
        ctx.beginPath();
        ctx.moveTo(points[0].x, points[0].y);
        for (let i = 1; i < points.length; i++) {
          ctx.lineTo(points[i].x, points[i].y);
        }
        ctx.closePath();

        const grad = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
        grad.addColorStop(0, r === 1 ? "#50E3C2" : "#9D6DE8");
        grad.addColorStop(1, r === 2 ? "#D97706" : "#45246B");

        ctx.strokeStyle = grad;
        ctx.lineWidth = 2;
        ctx.stroke();

        // Draw nodes
        points.forEach((pt, pIdx) => {
          if (pIdx % 2 === 0) {
            ctx.beginPath();
            ctx.arc(pt.x, pt.y, 3, 0, Math.PI * 2);
            ctx.fillStyle = "#FFFFFF";
            ctx.fill();
          }
        });
      }

      animationFrameId = requestAnimationFrame(draw);
    }

    draw();
  }

  // CI/CD SIMULATION
  const runCiBtn = document.getElementById("run-ci-btn");
  const ciLogs = document.getElementById("ci-logs");
  const steps = ["step-lint", "step-types", "step-test", "step-build", "step-deploy"];

  runCiBtn?.addEventListener("click", () => {
    if (!runCiBtn) return;
    runCiBtn.setAttribute("disabled", "true");
    runCiBtn.innerHTML = `<span>⚙ Simulation en cours...</span>`;

    // Reset visual steps
    steps.forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        el.classList.remove("passed");
        el.classList.add("running");
      }
    });

    if (ciLogs) {
      ciLogs.innerHTML = `<code>$ git checkout -qf 8f3c92a\n[INFO] Starting CI/CD runner verification...</code>`;
    }

    let current = 0;
    const interval = setInterval(() => {
      if (current < steps.length) {
        const stepId = steps[current];
        const el = document.getElementById(stepId);
        if (el) {
          el.classList.remove("running");
          el.classList.add("passed");
        }

        if (ciLogs) {
          if (current === 0) ciLogs.innerHTML += `\n<code>$ pnpm run lint [✓ ESLint passed]</code>`;
          if (current === 1) ciLogs.innerHTML += `\n<code>$ tsc --noEmit [✓ Types verified]</code>`;
          if (current === 2) ciLogs.innerHTML += `\n<code>$ vitest run [✓ 18 tests passed]</code>`;
          if (current === 3) ciLogs.innerHTML += `\n<code>$ docker build -t dishly:prod [✓ Image ready]</code>`;
          if (current === 4) ciLogs.innerHTML += `\n<code>[SUCCESS] Production deployment validated on cluster!</code>`;
        }
        current++;
      } else {
        clearInterval(interval);
        runCiBtn.removeAttribute("disabled");
        runCiBtn.innerHTML = `<span>↻ Relancer la simulation</span>`;
      }
    }, 450);
  });
</script>

