---
import ArchitectureFlow from "./ArchitectureFlow.astro";
import MobileSkills from "./MobileSkills.astro";

const categories = [
  {
    "id": "frontend",
    "name": "Frontend",
    "title": "Des interfaces claires et réactives",
    "description": "Je construis des interfaces web avec des composants réutilisables et une mise en page adaptée à chaque écran.",
    "context": "En pratique",
    "technologies": [
      "React 19",
      "JavaScript",
      "Vue.js",
      "Next.js",
      "Astro",
      "Tailwind CSS",
      "HTML5 / Semantic",
      "CSS Modulaire",
      "State Management"
    ]
  },
  {
    "id": "backend",
    "name": "Backend",
    "title": "La logique derrière l’interface",
    "description": "Je structure les API, la validation des données et l’authentification. J’étudie aussi les design patterns pour mieux organiser la logique des applications.",
    "context": "API & données",
    "technologies": [
      "Node.js",
      "Express",
      "Prisma ORM",
      "RESTful APIs",
      "Auth & JWT",
      "Middleware Architecture",
      "Design Patterns (en cours)"
    ]
  },
  {
    "id": "data",
    "name": "Données",
    "title": "Des données bien organisées",
    "description": "Je modélise les relations entre les données et j’utilise SQL pour les enregistrer, les retrouver et les faire évoluer.",
    "context": "Modélisation",
    "technologies": [
      "PostgreSQL",
      "SQL",
      "MySQL",
      "Schema Migrations",
      "Relations & Indexation"
    ]
  },
  {
    "id": "devops",
    "name": "DevOps",
    "title": "Le déploiement en apprentissage",
    "description": "Je pratique Git, mais je n’ai pas encore déployé d’application en production. J’apprends actuellement GitLab, Docker, Linux et les différentes étapes d’un déploiement.",
    "context": "DevOps & déploiement · En cours d’apprentissage",
    "technologies": [
      "Git & GitHub Flow",
      "GitHub Actions (CI/CD)",
      "GitLab (en cours)",
      "Docker Basics",
      "Administration Linux (en cours)",
      "Postman ",
      "Linux CLI",
      "Swagger / OpenAPI"
    ]
  }
];

---

<section id="skills" class="skills">
  <div class="container">

    <div class="skills-topbar">
      <div class="section-index">
        <span>03</span>
        <span class="line"></span>
        <p>Stack & Architecture</p>
      </div>

      <div class="skills-header-grid">
        <h2>
          Ma boîte à outils.<br />
          <span>Du code au déploiement.</span>
        </h2>

        <p class="skills-lead desktop-intro">
          Les technologies que je mets en pratique dans mes projets, et les outils que j’explore pour aller plus loin. Le schéma ci-dessous permet de suivre le trajet d’une requête à travers une application.
        </p>
        <p class="skills-lead mobile-intro">Les outils que je pratique, de l’interface au déploiement. Explore chaque catégorie.</p>
      </div>
    </div>

    <MobileSkills categories={categories} />

    <!-- Live Interactive Full Stack Architecture Pipeline -->
    <div class="arch-section" data-motion="architecture">
      <ArchitectureFlow />
    </div>

    <!-- Shared data keeps desktop and mobile technologies in sync. -->
    <div class="skills-list">
      {categories.map((category, index) => (
        <div class="skill-row">
          <span class="number">0{index + 1}</span>
          <div class="skill-meta">
            <h3>{category.id === 'data' ? 'Database' : category.id === 'devops' ? 'DevOps & QA' : category.name}</h3>
            {category.href ? <a class="skill-subtitle" href={category.href}>{category.context}</a> : <span class="skill-subtitle">{category.context}</span>}
          </div>
          <div class="tags">{category.technologies.map(tech => <span>{tech}</span>)}</div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .mobile-intro { display: none; }
  .skills {
    padding: 130px 0;
    background: var(--bg-subtle);
    color: var(--text-main);
    border-block: 1px solid var(--border);
  }

  .container {
    width: min(1140px, 92%);
    margin: 0 auto;
  }

  .skills-topbar {
    margin-bottom: 50px;
  }

  .section-index {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }

  .section-index span:first-child {
    font-family: var(--font-sans);
    color: var(--accent-sage);
  }

  .line {
    width: 42px;
    height: 1px;
    background: var(--accent-sage);
  }

  .section-index p {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-sage);
  }

  .skills-header-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: end;
  }

  h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 3.3rem);
    line-height: 1.15;
    letter-spacing: -2px;
    color: var(--text-main);
  }

  .skills-lead {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-muted);
    max-width: 500px;
  }

  .arch-section {
    margin-bottom: 40px;
  }

  /* LIST */

  .skills-list {
    border-top: 1px solid var(--border);
  }

  .skill-row {
    display: grid;
    grid-template-columns: 50px 200px 1fr;
    gap: 24px;
    padding: 28px 0;
    align-items: start;
    border-bottom: 1px solid var(--border);
    transition: padding-left 0.25s ease, background 0.25s ease;
  }

  .skill-row:hover {
    padding-left: 10px;
    background: var(--card);
  }

  .number {
    color: var(--accent-sage);
    font-size: 0.78rem;
    font-weight: 700;
    padding-top: 4px;
    font-family: var(--font-sans);
  }

  .skill-meta h3 {
    margin: 0 0 4px;
    font-family: var(--font-sans);
    font-size: 1.35rem;
    color: var(--text-main);
  }

  .skill-subtitle {
    font-size: 0.72rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--accent-sage);
    font-weight: 600;
  }

  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tags span {
    border: 1px solid var(--border);
    padding: 7px 13px;
    border-radius: 5px;
    font-size: 0.78rem;
    color: var(--text-muted);
    background: var(--card);
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
  }

  .tags span:hover {
    background: var(--accent-sage);
    color: #fff;
    border-color: var(--accent-sage);
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .skills {
      padding: 90px 0;
    }

    .skills-header-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .skill-row {
      grid-template-columns: 40px 1fr;
    }

    .tags {
      grid-column: 2;
      margin-top: 8px;
    }
  }

  @media (max-width: 520px) {
    .skills {
      padding: 75px 0;
    }

    .skill-row {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 22px 0;
    }

    .number, .tags {
      grid-column: auto;
    }

    .tags span {
      font-size: 0.72rem;
      padding: 6px 10px;
    }
  }
  @media (max-width: 767px) {
    .arch-section, .skills-list, .desktop-intro { display: none; }
    .mobile-intro { display: block; }
    .skills { padding: 64px 0; }
    .skills-topbar { margin-bottom: 24px; }
    .section-index { margin-bottom: 20px; gap: 10px; }
    .section-index p { letter-spacing: 1.6px; font-size: 0.68rem; }
    .skills-header-grid { gap: 16px; }
    h2 { font-size: clamp(1.8rem, 7vw, 2.5rem); letter-spacing: -1px; }
    .skills-lead { font-size: 0.92rem; line-height: 1.7; }
  }
  h2 span { color: var(--primary); }
  .skill-subtitle[href]:hover { text-decoration: underline; text-underline-offset: 4px; }
</style>
