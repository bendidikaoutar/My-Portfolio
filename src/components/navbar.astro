---
// navbar.astro - Navigation et choix du thème
---

<nav id="main-nav">
  <div class="nav-container">

    <!-- Logo -->
    <a href="#home" class="logo" aria-label="Kaoutar Bendidi Accueil">
      <span class="logo-bracket">&lt;</span>
      <span class="logo-name">Kaoutar</span>
      <span class="logo-tag">.dev</span>
      <span class="logo-bracket">/&gt;</span>
    </a>

    <!-- Thème clair ou sombre -->
    <div class="mode-switch-wrapper" role="group" aria-label="Thème d’affichage">
      <button
        type="button"
        class="switch-pill"
        id="switch-visual"

        aria-pressed="false"
        aria-label="Thème clair" title="Thème clair"
      >
        <span class="pill-icon" aria-hidden="true">☼</span>
        <span class="pill-label">Clair</span>
      </button>
      <button
        type="button"
        class="switch-pill active"
        id="switch-code"

        aria-pressed="true"
        aria-label="Thème sombre" title="Thème sombre"
      >
        <span class="pill-icon" aria-hidden="true">☾</span>
        <span class="pill-label">Sombre</span>
      </button>
    </div>

    <!-- Menu Links -->
    <ul class="nav-links" id="nav-links">
      <li><a href="#about">À propos</a></li>
      <li><a href="#skills">Stack</a></li>
      <li><a href="#projects">Projets</a></li>
      <li><a href="#contact" class="nav-contact-btn">Contact</a></li>
    </ul>

    <!-- Mobile Menu Toggle -->
    <button class="mobile-toggle" id="mobile-toggle-btn" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="nav-links">
      <span></span>
      <span></span>
    </button>

  </div>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
</nav>

<script>
  // Initialisation du thème
  const html = document.documentElement;
  const switchVisual = document.getElementById("switch-visual");
  const switchCode = document.getElementById("switch-code");
  const mobileToggle = document.getElementById("mobile-toggle-btn");
  const navLinks = document.querySelector(".nav-links");
  const modeStorageKey = "kaoutar_portfolio_mode";

  function saveMode(mode: "code" | "visual") {
    try {
      localStorage.setItem(modeStorageKey, mode);
    } catch {
      // The current mode still works when browser storage is unavailable.
    }
  }

  function setMode(isDev: boolean) {
    if (isDev) {
      html.setAttribute("data-dev-mode", "true");
      switchVisual?.classList.remove("active");
      switchVisual?.setAttribute("aria-pressed", "false");
      switchCode?.classList.add("active");
      switchCode?.setAttribute("aria-pressed", "true");
      saveMode("code");
    } else {
      html.removeAttribute("data-dev-mode");
      switchCode?.classList.remove("active");
      switchCode?.setAttribute("aria-pressed", "false");
      switchVisual?.classList.add("active");
      switchVisual?.setAttribute("aria-pressed", "true");
      saveMode("visual");
    }
    window.dispatchEvent(new CustomEvent("portfolio-mode-changed", { detail: { isDev } }));
  }

  // Restore saved preference
  let savedMode: string | null = null;
  try {
    savedMode = localStorage.getItem(modeStorageKey);
  } catch {
    // Keep the default dark mode when browser storage is unavailable.
  }
  if (savedMode === "visual") {
    setMode(false);
  } else {
    setMode(true);
  }

  switchVisual?.addEventListener("click", () => setMode(false));
  switchCode?.addEventListener("click", () => setMode(true));

  // Mobile navigation
  mobileToggle?.addEventListener("click", () => {
    navLinks?.classList.toggle("open");
    const isOpen = mobileToggle.classList.toggle("active");
    mobileToggle.setAttribute("aria-expanded", String(isOpen));
    mobileToggle.setAttribute("aria-label", isOpen ? "Fermer le menu" : "Ouvrir le menu");
  });

  document.querySelectorAll(".nav-links a").forEach((link) => {
    link.addEventListener("click", () => {
      navLinks?.classList.remove("open");
      mobileToggle?.classList.remove("active");
      mobileToggle?.setAttribute("aria-expanded", "false");
      mobileToggle?.setAttribute("aria-label", "Ouvrir le menu");
    });
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && navLinks?.classList.contains("open")) {
      mobileToggle?.click();
      mobileToggle?.focus();
    }
  });
</script>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    border-bottom: 1px solid var(--border);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .nav-container {
    width: min(1180px, 92%);
    margin: 0 auto;
    min-height: 70px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  /* Logo */
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
    letter-spacing: -0.5px;
    padding: 6px 0;
  }

  .logo-bracket {
    color: var(--accent-sage);
    font-weight: 600;
  }

  .logo-tag {
    color: var(--primary);
  }

  /* Dual Switch */
  .mode-switch-wrapper {
    display: flex;
    align-items: center;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    padding: 3px;
    border-radius: 6px;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.05);
  }

  .switch-pill {
    background: transparent;
    border: none;
    padding: 8px 13px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-soft);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.2, 0.9, 0.3, 1);
  }

  .switch-pill.active {
    background: var(--card);
    color: var(--primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .pill-icon {
    font-size: 0.85rem;
  }

  /* Nav Links */
  .nav-links {
    display: flex;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .nav-links a {
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    position: relative;
    padding: 4px 0;
  }

  .nav-links a:hover {
    color: var(--primary);
  }

  .nav-highlight {
    color: var(--primary) !important;
    font-weight: 600 !important;
  }

  .nav-contact-btn {
    background: var(--primary-light);
    color: var(--primary) !important;
    padding: 6px 14px !important;
    border-radius: 8px;
    font-weight: 600 !important;
  }

  .nav-contact-btn:hover {
    background: var(--primary);
    color: var(--on-primary) !important;
    transform: translateY(-1px);
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: none;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 8px;
  }

  .mobile-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text-main);
    margin: 5px 0;
    transition: 0.3s ease;
  }

  @media (max-width: 820px) {
    .mobile-toggle {
      display: block;
      z-index: 1001;
    }

    .nav-links {
      position: absolute;
      top: 70px;
      left: 0;
      right: 0;
      width: 100%;
      padding: 24px 6% 30px;
      flex-direction: column;
      align-items: center;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-15px);
      transition: all 0.3s ease;
      box-shadow: var(--shadow-lg);
    }

    .nav-links.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    .mobile-toggle.active span:first-child {
      transform: rotate(45deg) translate(5px, 5px);
    }

    .mobile-toggle.active span:last-child {
      transform: rotate(-45deg) translate(0, 0);
    }
  }

  @media (max-width: 480px) {
    .pill-label {
      display: none;
    }
    .switch-pill {
      padding: 5px 9px;
    }
  }
</style>
