---
const projects = [
  {
    number: "02",
    title: "Muestra",
    category: "Educational Platform",
    description:
      "Plateforme éducative développée en équipe, avec contribution aux interfaces frontend et à l’intégration du pipeline CI/CD.",
    technologies: ["Vue.js", "JavaScript", "Git", "GitHub", "CI/CD"],
    github: "#",
  },
  {
    number: "03",
    title: "Sehati",
    category: "Web Application",
    status: "In Progress",
    description:
      "Application web Full Stack moderne avec développement des fonctionnalités frontend et backend.",
    technologies: ["JavaScript", "Vue.js", "Node.js", "MySQL", "Next.js"],
    github: "#",
  },
  {
    number: "04",
    title: "Dishly",
    category: "Full Stack Application",
    meta: "FULL STACK DEVELOPMENT · 2026",
    status: "In Progress",
    description:
      "Application Full Stack permettant de créer, organiser et gérer des recettes à travers une interface moderne et une API REST.",
    technologies: ["React", "Node.js", "Express", "Prisma", "PostgreSQL"],
    github: "#",
  },
  {
    number: "05",
    title: "Interactive Generative Studio",
    category: "Creative Coding",
    description:
      "Plateforme créative interactive permettant de générer et manipuler des contenus visuels grâce à différents modules de génération, traitement d’images et visualisation de données.",
    technologies: ["Python", "Flask", "Matplotlib", "Pandas", "OpenCV"],
    github: "#",
  },
  {
    number: "06",
    title: "Budget App",
    category: "Python Utility",
    description:
      "Application Python conçue pour gérer les dépenses personnelles, suivre un budget et organiser les données financières.",
    technologies: ["Python"],
    github: "#",
  },
];

const featuredProject = projects.find((project) => project.title === "Dishly");
const otherProjects = projects.filter((project) => project.title !== "Dishly");
---

<section id="projects" class="projects reveal">
  <div class="container">
    <div class="projects-header">
      <div class="section-index">
        <span>04</span>
        <span class="line"></span>
        <p>Projets</p>
      </div>

      <h2>
        Selected<br />
        work.
      </h2>

      <p class="intro">
        Une sélection de projets qui reflètent ma manière de penser,
        concevoir et développer des expériences digitales.
      </p>
    </div>

    <article class="featured-project">
      <div class="featured-content">
        <span class="featured-label">FEATURED PROJECT</span>
        {featuredProject.status && (
          <span class="status featured-status">IN PROGRESS</span>
        )}
        <h3>{featuredProject.title}</h3>
        <p>{featuredProject.description}</p>
        <span class="project-meta">{featuredProject.meta}</span>

        <div class="tags">
          {
            featuredProject.technologies.map((tech) => (
              <span>{tech}</span>
            ))
          }
        </div>

        <a class="project-link" href={featuredProject.github} target="_blank">
          GitHub <span>↗</span>
        </a>
      </div>

      <div class="featured-visual" aria-hidden="true">
        <div class="visual-panel">
          <span class="visual-label">DISHLY</span>
          <p class="visual-title">
            Recipe management<br />
            made simple.
          </p>
          <span class="visual-meta">FULL STACK · IN PROGRESS</span>
        </div>
      </div>
    </article>

    <div class="other-projects">
      {
        otherProjects.map((project) => (
          <article class="project-card">
            <div class="card-top">
              <span>{project.number}</span>

              {project.status && (
                <span class="status">IN PROGRESS</span>
              )}
            </div>

            <span class="category">{project.category}</span>
            <h3>{project.title}</h3>
            <p>{project.description}</p>

            {project.technologies.length > 0 && (
              <div class="tags compact-tags">
                {
                  project.technologies.map((tech) => (
                    <span>{tech}</span>
                  ))
                }
              </div>
            )}

            {project.github && (
              <a class="project-link" href={project.github} target="_blank">
                GitHub <span>↗</span>
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects {
    padding: 130px 0;
  }

  .container {
    width: min(1120px, 90%);
    margin: 0 auto;
  }

  .projects-header {
    display: grid;
    grid-template-columns: 0.7fr 1fr;
    column-gap: 80px;
    margin-bottom: 70px;
  }

  .section-index {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
  }

  .section-index span:first-child {
    color: var(--sage-dark);
    font-family: Georgia, serif;
  }

  .line {
    width: 42px;
    height: 1px;
    background: var(--sage);
  }

  .section-index p,
  .featured-label,
  .category,
  .project-meta {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 3.4px;
    font-size: 0.68rem;
    font-weight: 600;
  }

  .section-index p {
    color: var(--mauve);
  }

  .projects-header h2 {
    margin: 0;
    font-family: Georgia, serif;
    font-size: clamp(3.5rem, 7vw, 6rem);
    line-height: 0.9;
    letter-spacing: -3px;
    color: var(--mauve-dark);
  }

  .intro {
    max-width: 460px;
    align-self: end;
    margin: 0 0 8px;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-soft);
  }

  .featured-project {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.85fr);
    gap: 56px;
    align-items: stretch;
    padding: 42px;
    border: 1px solid var(--border);
    border-radius: 30px;
    background: var(--card);
  }

  .featured-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .featured-label,
  .project-meta,
  .category {
    color: var(--sage-dark);
  }

  .featured-content h3,
  .project-card h3 {
    margin: 18px 0 20px;
    font-family: Georgia, serif;
    font-weight: 600;
    color: var(--mauve-dark);
  }

  .featured-content h3 {
    font-size: clamp(3rem, 6vw, 5.2rem);
    line-height: 0.86;
    letter-spacing: -2.5px;
    font-style: italic;
  }

  .featured-content p,
  .project-card p {
    color: var(--text-soft);
    line-height: 1.8;
  }

  .featured-content p {
    max-width: 610px;
    margin: 0 0 24px;
    font-size: 1.02rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .tags span {
    padding: 7px 11px;
    border: 1px solid var(--border);
    border-radius: 100px;
    color: var(--text-soft);
    font-size: 0.75rem;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 34px;
    color: var(--mauve-dark);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid var(--mauve-dark);
    padding-bottom: 5px;
  }

  .project-link span {
    display: inline-block;
    transition: transform 0.25s ease;
  }

  .project-link:hover span {
    transform: translate(3px, -3px);
  }

  .featured-visual {
    min-height: 390px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 24px;
    background: var(--sage);
    overflow: hidden;
    position: relative;
  }

  .featured-visual::before {
    content: "";
    position: absolute;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: var(--mauve);
    opacity: 0.12;
    right: -80px;
    top: -90px;
  }

  .visual-panel {
    position: relative;
    z-index: 1;
    width: min(330px, 82%);
    aspect-ratio: 4 / 5;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 28px;
    border-radius: 20px;
    background: var(--mauve-dark);
    color: var(--bg);
  }

  .visual-label,
  .visual-meta {
    font-size: 0.68rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--bg) 72%, transparent);
  }

  .visual-title {
    margin: auto 0;
    font-family: Georgia, serif;
    font-size: clamp(2rem, 3vw, 2.75rem);
    line-height: 1.02;
    letter-spacing: -1.3px;
    font-weight: 500;
    color: var(--bg);
  }

  .other-projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    margin-top: 34px;
  }

  .project-card {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 24px;
    background: color-mix(in srgb, var(--card) 92%, var(--bg-soft));
    transition:
      transform 0.25s ease,
      border-color 0.25s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--mauve-dark) 24%, var(--border));
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 28px;
    color: var(--sage-dark);
    font-family: Georgia, serif;
  }

  .status {
    padding: 6px 10px;
    border-radius: 100px;
    background: var(--sage);
    color: var(--mauve-dark);
    font-family: Inter, Arial, sans-serif;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 1.6px;
    text-transform: uppercase;
  }

  .featured-status {
    margin-top: 14px;
  }

  .project-card h3 {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    line-height: 0.95;
    letter-spacing: -1.2px;
  }

  .project-card p {
    margin: 0;
    font-size: 0.94rem;
  }

  .compact-tags {
    margin-top: 24px;
  }

  .compact-tags span {
    font-size: 0.7rem;
    padding: 6px 10px;
  }

  .project-card .project-link {
    margin-top: auto;
    padding-top: 28px;
    align-self: flex-start;
  }

  @media (max-width: 850px) {
    .projects {
      padding: 90px 0;
    }

    .projects-header,
    .featured-project,
    .other-projects {
      grid-template-columns: 1fr;
    }

    .projects-header {
      gap: 35px;
    }

    .intro {
      margin-top: 15px;
    }

    .featured-visual {
      min-height: 330px;
    }
  }

  @media (max-width: 500px) {
    .container {
      width: min(94%, 1120px);
    }

    .projects {
      padding: 75px 0;
    }

    .projects-header {
      margin-bottom: 48px;
    }

    .featured-project {
      padding: 24px;
      border-radius: 22px;
      gap: 30px;
    }

    .featured-content h3 {
      font-size: clamp(2.7rem, 14vw, 4rem);
    }

    .featured-visual {
      min-height: 280px;
      border-radius: 20px;
    }

    .visual-panel {
      width: min(280px, 88%);
      padding: 22px;
      border-radius: 18px;
    }

    .project-card {
      padding: 22px;
      border-radius: 20px;
    }

    .tags {
      gap: 6px;
    }

    .tags span {
      font-size: 0.7rem;
    }
  }
</style>
