---
import ApiPlayground from "./ApiPlayground.astro";
import ScrollTypewriter from "./ScrollTypewriter.astro";

const projects = [
  {
    title: "Dishly",
    category: "Application Full Stack",
    tagline: "Plateforme culinaire collaborative & API REST haute performance",
    description: "Application complète permettant aux passionnés de cuisine de créer, organiser et partager des recettes avec recherche avancée par tags, calcul nutritionnel et modélisation relationnelle de données.",
    technologies: ["React 19", "Node.js", "Express", "Prisma ORM", "PostgreSQL", "Tailwind CSS"],
    highlights: ["API REST avec documentation Swagger", "Transactions SQL sécurisées", "Temps de réponse < 25ms"],
    isFeatured: true
  },
  {
    title: "Muestra",
    category: "Plateforme Éducative",
    tagline: "Expérience d'apprentissage interactive & collaborative",
    description: "Plateforme développée en équipe académique pour dynamiser les échanges étudiants, avec interfaces modulaires et mise en place d'un pipeline d'intégration continue CI/CD.",
    technologies: ["Vue.js", "JavaScript", "Git", "GitHub Actions", "CI/CD"],
    highlights: ["Composants réutilisables", "Pipeline de tests automatisé", "Travail d'équipe Agile"]
  },
  {
    title: "Sehati",
    category: "Application Santé & Bien-être",
    tagline: "Gestion simplifiée des rendez-vous et suivi médical",
    description: "Application web Full Stack dédiée à la prise de rendez-vous médicaux et au suivi des patients avec tableaux de bord réactifs et base de données relationnelle sécurisée.",
    technologies: ["Next.js", "Vue.js", "Node.js", "MySQL", "REST API"],
    highlights: ["Authentification sécurisée", "Modélisation relationnelle MySQL", "Expérience patient fluide"]
  },
  {
    title: "Interactive Generative Studio",
    category: "Creative Coding & Data",
    tagline: "Génération visuelle & manipulation algorithmique d'images",
    description: "Studio expérimental interactif permettant de générer et manipuler des contenus visuels grâce à des modules algorithmiques de traitement d'images et de visualisation mathématique.",
    technologies: ["Python", "Flask", "OpenCV", "Matplotlib", "Pandas"],
    highlights: ["Filtres de vision par ordinateur", "Visualisation de données", "Génération procédurale"]
  },
  {
    title: "Budget App",
    category: "Utilitaire Financier",
    tagline: "Suivi budgétaire & organisation des finances personnelles",
    description: "Outil logiciel conçu pour catégoriser les flux de dépenses, modéliser des budgets prévisionnels et générer des analyses claires de santé financière.",
    technologies: ["Python", "Data Processing", "CLI & GUI"],
    highlights: ["Calculs analytiques", "Export structuré de données", "Simplicité d'usage"]
  }
];

const featuredProject = projects[0];
const otherProjects = projects.slice(1);
---

<section id="projects" class="projects reveal">
  <div class="container">

    <div class="projects-header reveal-item reveal-delay-1">
      <div class="section-tag">
        <span class="tag-num">04</span>
        <span class="tag-title">RÉALISATIONS MAJEURES</span>
      </div>

      <div class="header-content-grid">
        <h2>
          Projets conçus avec<br />
          <span class="gradient-text">passion et rigueur.</span>
        </h2>

        <p class="intro">
          <ScrollTypewriter text="Une sélection d'applications complètes développées pour résoudre des besoins concrets, alliant qualité de code et expérience utilisateur soignée." />
        </p>
      </div>
    </div>

    <!-- Featured Project: Dishly with Live API Playground -->
    <article class="featured-project reveal-item reveal-delay-2">
      <div class="featured-content">
        <div class="featured-meta-row">
          <span class="featured-badge">PROJET PHARE</span>
          <span class="category-pill">{featuredProject.category}</span>
        </div>

        <h3>{featuredProject.title}</h3>
        <p class="featured-tagline">{featuredProject.tagline}</p>
        <p class="featured-desc">{featuredProject.description}</p>

        <!-- Highlights -->
        <div class="highlights-list">
          {featuredProject.highlights.map(item => (
            <div class="highlight-item">
              <span class="check-icon">✓</span>
              <span>{item}</span>
            </div>
          ))}
        </div>

        <div class="tags">
          {featuredProject.technologies.map(tech => (
            <span class="tech-tag">{tech}</span>
          ))}
        </div>
      </div>

      <!-- Live API Playground or Interactive Showcase -->
      <div class="featured-visual">
        <div class="playground-frame-header">
          <span class="pulse-indicator"></span>
          <span>BANC D'ESSAI API REST EN DIRECT</span>
        </div>
        <ApiPlayground />
      </div>
    </article>

    <!-- Other Projects Grid -->
    <div class="other-projects reveal-item reveal-delay-3">
      {otherProjects.map((project, idx) => (
        <article class="project-card">
          <div class="card-header">
            <span class="card-num">0{idx + 2}</span>
            <span class="card-category">{project.category}</span>
          </div>

          <h3 class="card-title">{project.title}</h3>
          <p class="card-tagline">{project.tagline}</p>
          <p class="card-desc">{project.description}</p>

          <div class="tags">
            {project.technologies.map(tech => (
              <span class="tech-tag">{tech}</span>
            ))}
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .projects {
    padding: 110px 0 130px;
  }

  .container {
    width: min(1180px, 92%);
    margin: 0 auto;
  }

  .projects-header {
    margin-bottom: 60px;
  }

  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--accent-sage-light);
    color: var(--accent-sage);
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 700;
    margin-bottom: 20px;
    letter-spacing: 0.5px;
  }

  .tag-num {
    font-family: var(--font-mono);
  }

  .header-content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: end;
  }

  h2 {
    margin: 0;
    font-size: clamp(2.4rem, 4.4vw, 3.6rem);
    line-height: 1.1;
    letter-spacing: -1.5px;
    font-weight: 800;
    color: var(--text-main);
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--primary) 20%, var(--accent-sage) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .intro {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text-muted);
    margin: 0;
  }

  /* Featured Project Card */
  .featured-project {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 48px;
    align-items: center;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: 28px;
    padding: 42px;
    box-shadow: var(--shadow-lg);
    margin-bottom: 40px;
  }

  .featured-meta-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .featured-badge {
    background: var(--primary);
    color: #FFFFFF;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 999px;
    letter-spacing: 0.5px;
  }

  .category-pill {
    font-size: 0.75rem;
    color: var(--text-soft);
    font-weight: 600;
  }

  .featured-content h3 {
    font-size: clamp(2rem, 3.6vw, 2.8rem);
    font-weight: 800;
    color: var(--text-main);
    letter-spacing: -1px;
    margin: 0 0 8px;
  }

  .featured-tagline {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--primary);
    margin: 0 0 16px;
  }

  .featured-desc {
    font-size: 0.96rem;
    line-height: 1.7;
    color: var(--text-muted);
    margin: 0 0 24px;
  }

  .highlights-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 24px;
  }

  .highlight-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--text-main);
    font-weight: 500;
  }

  .check-icon {
    color: var(--accent-sage);
    font-weight: 700;
  }

  /* Tags */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .tech-tag {
    padding: 5px 12px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: all 0.2s ease;
  }

  .tech-tag:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  /* Visual Playground Wrapper */
  .featured-visual {
    background: #14101D;
    border-radius: 20px;
    border: 1px solid #2B233D;
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .playground-frame-header {
    background: #0E0B16;
    padding: 8px 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: #A396BC;
    font-weight: 600;
    letter-spacing: 0.5px;
    border-bottom: 1px solid #221B32;
  }

  .pulse-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #50E3C2;
    box-shadow: 0 0 6px #50E3C2;
  }

  /* Other Projects Grid */
  .other-projects {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .project-card {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: 22px;
    padding: 30px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .project-card:hover {
    transform: translateY(-3px);
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .card-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--primary);
  }

  .card-category {
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--text-soft);
  }

  .card-title {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--text-main);
    letter-spacing: -0.4px;
    margin: 0 0 6px;
  }

  .card-tagline {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--primary);
    margin: 0 0 12px;
  }

  .card-desc {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0 0 20px;
    flex: 1;
  }

  @media (max-width: 980px) {
    .header-content-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .featured-project {
      grid-template-columns: 1fr;
      gap: 34px;
      padding: 30px 24px;
    }

    .other-projects {
      grid-template-columns: 1fr;
    }
  }
</style>
