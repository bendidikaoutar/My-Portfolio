---
const projects = [
  {
    number: "01",
    title: "Recipe Book",
    description:
      "Application Full Stack permettant de créer, organiser et gérer des recettes à travers une interface moderne et une API REST.",
    technologies: [
      "React",
      "Node.js",
      "Express",
      "Prisma",
      "PostgreSQL",
    ],
    github: "#",
    demo: "#",
  },

  {
    number: "02",
    title: "Muestra",
    description:
      "Plateforme éducative développée en équipe, avec contribution aux interfaces frontend et à l’intégration du pipeline CI/CD.",
    technologies: [
      "Vue.js",
      "JavaScript",
      "Git",
      "GitHub",
      "CI/CD",
    ],
    github: "#",
    demo: "#",
  },

  {
    number: "03",
    title: "Sehati",
    status: "In Progress",
    description:
      "Application web Full Stack moderne avec développement des fonctionnalités frontend et backend.",
    technologies: [
      "JavaScript",
      "Vue.js",
      "Node.js",
      "MySQL",
      "Next.js",
    ],
    github: "#",
    demo: "#",
  },

  {
    number: "04",
    title: "Dishely",
    status: "In Progress",
    description:
      "Projet actuellement en cours de développement.",
    technologies: [],
    github: "#",
    demo: "#",
  },

  {
    number: "05",
    title: "Interactive Generative Studio",
    description:
      "Plateforme créative interactive permettant de générer et manipuler des contenus visuels grâce à différents modules de génération, traitement d’images et visualisation de données.",
    technologies: [
      "Python",
      "Flask",
      "Matplotlib",
      "Pandas",
      "OpenCV",
    ],
    github: "#",
    demo: "#",
  },

  {
    number: "06",
    title: "Budget App",
    description:
      "Application Python conçue pour gérer les dépenses personnelles, suivre un budget et organiser les données financières.",
    technologies: ["Python"],
    github: "#",
    demo: "#",
  },
];
---

<section id="projects" class="projects reveal">
  <div class="container">

    <div class="projects-header">
      <div class="section-index">
        <span>04</span>
        <span class="line"></span>
        <p>Projets</p>
      </div>

      <h2>
        Selected<br />
        work.
      </h2>

      <p class="intro">
        Une sélection de projets qui reflètent ma manière de penser,
        concevoir et développer des expériences digitales.
      </p>
    </div>

    <div class="projects-list">
      {
        projects.map((project) => (
          <article class="project">

            <div class="project-top">
              <div class="project-number">
                <span>{project.number}</span>

                {project.status && (
                  <span class="status">{project.status}</span>
                )}
              </div>

              <span>Project</span>
            </div>

            <div class="project-visual">
              <div class="browser">

                <div class="browser-bar">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <div class="preview">
                  <span>{project.title}</span>

                  <h3>{project.title}</h3>

                  <div class="fake-button">
                    Découvrir le projet
                  </div>
                </div>

              </div>

              <span class="visual-note">
                Build / Test / Refine
              </span>
            </div>

            <div class="project-info">

              <div>
                <h3>{project.title}</h3>

                <p>{project.description}</p>
              </div>

              <div class="project-details">

                {project.technologies.length > 0 && (
                  <div class="tags">
                    {
                      project.technologies.map((tech) => (
                        <span>{tech}</span>
                      ))
                    }
                  </div>
                )}

                <div class="links">
                  <a href={project.github} target="_blank">
                    GitHub <span>↗</span>
                  </a>

                  <a href={project.demo} target="_blank">
                    Voir le projet <span>↗</span>
                  </a>
                </div>

              </div>

            </div>

          </article>
        ))
      }
    </div>

  </div>
</section>

<style>
  .projects {
    padding: 130px 0;
  }

  .container {
    width: min(1120px, 90%);
    margin: 0 auto;
  }

  .projects-header {
    display: grid;
    grid-template-columns: 0.7fr 1fr;
    column-gap: 80px;
    margin-bottom: 70px;
  }

  .section-index {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
  }

  .section-index span:first-child {
    color: var(--sage-dark);
    font-family: Georgia, serif;
  }

  .line {
    width: 42px;
    height: 1px;
    background: var(--sage);
  }

  .section-index p {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--mauve);
  }

  .projects-header h2 {
    margin: 0;
    font-family: Georgia, serif;
    font-size: clamp(3.5rem, 7vw, 6rem);
    line-height: 0.9;
    letter-spacing: -3px;
    color: var(--mauve-dark);
  }

  .intro {
    max-width: 460px;
    align-self: end;
    margin: 0 0 8px;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-soft);
  }

  .project {
    border-top: 1px solid var(--border);
    padding-top: 22px;
    margin-bottom: 80px;
  }

  .project-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 22px;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.68rem;
    color: var(--text-soft);
  }

  .project-number {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .status {
    padding: 6px 10px;
    border-radius: 100px;
    background: var(--sage);
    color: var(--mauve-dark);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .project-visual {
    min-height: 500px;
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 30px;
    overflow: hidden;

    background: var(--sage);
    padding: 55px;
  }

  .project-visual::before {
    content: "";
    position: absolute;

    width: 380px;
    height: 380px;

    border-radius: 50%;

    background: var(--mauve);
    opacity: 0.12;

    top: -150px;
    right: -80px;
  }

  .browser {
    width: min(760px, 95%);
    border-radius: 16px;
    overflow: hidden;

    background: var(--card);

    box-shadow:
      0 30px 80px
      color-mix(
        in srgb,
        var(--mauve-dark) 25%,
        transparent
      );

    transition: transform 0.4s ease;
  }

  .project:hover .browser {
    transform: translateY(-8px) rotate(-1deg);
  }

  .browser-bar {
    height: 34px;

    display: flex;
    align-items: center;

    gap: 6px;
    padding: 0 14px;

    background: var(--mauve-dark);
  }

  .browser-bar span {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background:
      color-mix(
        in srgb,
        var(--bg) 45%,
        transparent
      );
  }

  .preview {
    min-height: 300px;
    padding: 55px;

    background: var(--card);
    color: var(--mauve-dark);
  }

  .preview > span {
    text-transform: uppercase;
    letter-spacing: 3px;

    font-size: 0.65rem;

    color: var(--sage-dark);
  }

  .preview h3 {
    margin: 30px 0;

    max-width: 500px;

    font-family: Georgia, serif;

    font-size: clamp(2.8rem, 5vw, 4.5rem);

    line-height: 0.95;
    letter-spacing: -2px;
  }

  .fake-button {
    display: inline-block;

    padding: 11px 16px;

    border-radius: 100px;

    background: var(--mauve-dark);
    color: var(--bg);

    font-size: 0.75rem;
  }

  .visual-note {
    position: absolute;

    right: 28px;
    bottom: 24px;

    font-size: 0.65rem;

    text-transform: uppercase;
    letter-spacing: 2px;

    color: var(--mauve-dark);
  }

  .project-info {
    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: 70px;

    padding: 45px 0 20px;
  }

  .project-info h3 {
    margin: 0 0 18px;

    font-family: Georgia, serif;

    font-size: clamp(2.3rem, 4vw, 3.5rem);

    color: var(--mauve-dark);
  }

  .project-info p {
    max-width: 530px;

    margin: 0;

    color: var(--text-soft);

    line-height: 1.8;
  }

  .project-details {
    display: flex;
    flex-direction: column;

    justify-content: space-between;
  }

  .tags {
    display: flex;
    gap: 8px;

    flex-wrap: wrap;
  }

  .tags span {
    padding: 7px 11px;

    border: 1px solid var(--border);

    border-radius: 100px;

    color: var(--text-soft);

    font-size: 0.75rem;
  }

  .links {
    display: flex;

    gap: 28px;

    margin-top: 35px;
  }

  .links a {
    color: var(--mauve-dark);

    font-weight: 700;

    text-decoration: none;

    border-bottom: 1px solid var(--mauve-dark);

    padding-bottom: 5px;
  }

  .links span {
    display: inline-block;
    transition: transform 0.25s ease;
  }

  .links a:hover span {
    transform: translate(3px, -3px);
  }

  @media (max-width: 850px) {
    .projects {
      padding: 90px 0;
    }

    .projects-header,
    .project-info {
      grid-template-columns: 1fr;
      gap: 35px;
    }

    .intro {
      margin-top: 15px;
    }

    .project-visual {
      min-height: 400px;
      padding: 30px;
    }
  }

  @media (max-width: 500px) {
    .container {
      width: min(94%, 1120px);
    }

    .projects {
      padding: 75px 0;
    }

    .project {
      margin-bottom: 60px;
    }

    .project-top {
      gap: 15px;
    }

    .project-visual {
      min-height: 330px;
      padding: 18px;
      border-radius: 22px;
    }

    .preview {
      min-height: 240px;
      padding: 30px;
    }

    .preview h3 {
      font-size: 2.5rem;
    }

    .project-info {
      padding-top: 30px;
    }

    .project-info h3 {
      font-size: 2.2rem;
    }

    .project-info p {
      font-size: 0.95rem;
    }

    .tags {
      gap: 6px;
    }

    .tags span {
      font-size: 0.7rem;
    }

    .visual-note {
      display: none;
    }

    .links {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
