---
import ApiPlayground from "./ApiPlayground.astro";


const projects = [
  {
    title: "Dishly",
    category: "Application Full Stack",
    tagline: "Plateforme culinaire collaborative & API REST",
    description: "Application complète permettant aux passionnés de cuisine de créer, organiser et partager des recettes avec recherche avancée par tags, calcul nutritionnel et modélisation relationnelle de données.",
    technologies: ["React 19", "Node.js", "Express", "Prisma ORM", "PostgreSQL", "Tailwind CSS"],
    highlights: ["API REST avec documentation Swagger", "Transactions SQL sécurisées", "Recherche de recettes par tags"],
    isFeatured: true
  },
  {
    title: "Muestra",
    category: "Plateforme Éducative",
    tagline: "Expérience d'apprentissage interactive & collaborative",
    description: "Plateforme développée en équipe académique pour dynamiser les échanges étudiants, avec interfaces modulaires et mise en place d'un pipeline d'intégration continue CI/CD.",
    technologies: ["Vue.js", "JavaScript", "Git", "GitHub Actions", "CI/CD"],
    highlights: ["Composants réutilisables", "Pipeline de tests automatisé", "Travail d'équipe Agile"]
  },
  {
    title: "Sehati",
    category: "Application Santé & Bien-être",
    tagline: "Gestion simplifiée des rendez-vous et suivi médical",
    description: "Application web Full Stack dédiée à la prise de rendez-vous médicaux et au suivi des patients avec tableaux de bord réactifs et base de données relationnelle sécurisée.",
    technologies: ["Next.js", "Vue.js", "Node.js", "MySQL", "REST API"],
    highlights: ["Authentification sécurisée", "Modélisation relationnelle MySQL", "Expérience patient fluide"]
  },
  {
    title: "Interactive Generative Studio",
    category: "Creative Coding & Data",
    tagline: "Génération visuelle & manipulation algorithmique d'images",
    description: "Studio expérimental interactif permettant de générer et manipuler des contenus visuels grâce à des modules algorithmiques de traitement d'images et de visualisation mathématique.",
    technologies: ["Python", "Flask", "OpenCV", "Matplotlib", "Pandas"],
    highlights: ["Filtres de vision par ordinateur", "Visualisation de données", "Génération procédurale"]
  },
  {
    title: "Budget App",
    category: "Utilitaire Financier",
    tagline: "Suivi budgétaire & organisation des finances personnelles",
    description: "Outil logiciel conçu pour catégoriser les flux de dépenses, modéliser des budgets prévisionnels et générer des analyses claires de santé financière.",
    technologies: ["Python", "Data Processing", "CLI & GUI"],
    highlights: ["Calculs analytiques", "Export structuré de données", "Simplicité d'usage"]
  }
];

const featuredProject = projects[0];
const otherProjects = projects.slice(1);
---

<section id="projects" class="projects">
  <div class="container">
    <header class="projects-header">
      <div>
        <p class="section-label">04 <span>/</span> projets sélectionnés</p>
        <h2>Des idées.<br /><span>Du code. Des projets.</span></h2>
      </div>
      <div class="header-intro">
        <p>Des applications pour mettre en pratique mes apprentissages, résoudre des besoins concrets et explorer de nouvelles technologies.</p>
        <a href="https://github.com/bendidikaoutar" target="_blank" rel="noopener noreferrer">Mon profil GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <article class="featured-project" id="project-dishly">
      <div class="project-bar"><span>01 / dishly</span><span>Projet Full Stack</span></div>
      <div class="featured-grid">
        <div class="featured-content">
          <p class="project-label">APPLICATION CULINAIRE</p>
          <h3>{featuredProject.title}</h3>
          <p class="project-purpose">Créer, organiser et partager ses recettes au même endroit.</p>
          <p class="featured-desc">{featuredProject.description}</p>
          <dl class="project-notes">
            <div><dt>Le besoin</dt><dd>Retrouver et partager des recettes grâce à une recherche par tags.</dd></div>
            <div><dt>La construction</dt><dd>Une interface React, une API Express et des données relationnelles gérées avec Prisma et PostgreSQL.</dd></div>
          </dl>
          <div class="tags" aria-label="Technologies de Dishly">{featuredProject.technologies.map(tech => <span>{tech}</span>)}</div>
        </div>
        <figure class="featured-art">
          <img src="/dishly-featured.png" alt="Illustration de présentation de Dishly : organiser, créer et partager des recettes" width="1254" height="1254" loading="lazy" />
          <figcaption><span>Dishly</span> Visuel de présentation</figcaption>
        </figure>
      </div>
      <details class="technical-details featured-details">
        <summary><span><span class="detail-symbol" aria-hidden="true">&lt;/&gt;</span> Explorer le fonctionnement de l’API</span><span class="expand-icon" aria-hidden="true">+</span></summary>
        <div class="api-demo">
          <p class="simulation-note"><strong>Simulation interactive.</strong> Les réponses et les temps affichés sont des exemples locaux. Aucune requête n’est envoyée à un serveur.</p>
          <ApiPlayground />
        </div>
      </details>
    </article>

    <div class="other-projects" data-motion="projects">
      {otherProjects.map((project, idx) => (
        <div class="project-slot" style={`--project-index: ${idx}`}><article class="project-card" id={['project-muestra', 'project-sehati', 'project-studio', 'project-budget'][idx]}>
          <div class="project-bar"><span>0{idx + 2} / {['muestra', 'sehati', 'generative-studio', 'budget-app'][idx]}</span><span aria-hidden="true">⌁</span></div>
          <div class="card-content">
            <p class="project-label">{project.category}</p>
            <h3>{project.title}</h3>
            <p class="card-desc">{project.description}</p>
            {project.title === 'Muestra' && <p class="team-note">Projet académique réalisé en équipe.</p>}
            <div class="tags" aria-label={'Technologies de ' + project.title}>{project.technologies.map(tech => <span>{tech}</span>)}</div>
          </div>
          <details class="technical-details">
            <summary><span>À l’intérieur du projet</span><span class="expand-icon" aria-hidden="true">+</span></summary>
            <ul class="project-highlights">{project.highlights.map(item => <li>{item}</li>)}</ul>
          </details>
        </article></div>
      ))}
    </div>
  </div>
</section>

<style>
  .projects { padding: 100px 0; }
  .container { width: min(1180px, 92%); margin: 0 auto; }
  .projects-header { display: grid; grid-template-columns: 1.1fr 1fr; gap: 60px; align-items: end; margin-bottom: 40px; }
  .section-label { margin: 0 0 22px; font: 0.73rem var(--font-mono); color: var(--primary); }
  .section-label span { margin: 0 10px; color: var(--text-soft); }
  h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.3rem); line-height: 1.15; letter-spacing: -1.5px; }
  h2 > span { color: var(--primary); }
  .header-intro p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.8; margin: 0 0 16px; }
  .header-intro a { display: inline-flex; gap: 18px; font-size: 0.85rem; font-weight: 600; color: var(--primary); }
  .header-intro a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .featured-project, .project-card { background: var(--card); border: 1px solid var(--card-border); border-radius: 10px; overflow: hidden; scroll-margin-top: 100px; }
  .featured-project { margin-bottom: 24px; box-shadow: var(--shadow-sm); }
  .project-bar { background: var(--bg-subtle); padding: 13px 22px; border-bottom: 1px solid var(--card-border); display: flex; justify-content: space-between; gap: 16px; color: var(--text-muted); font: 0.7rem var(--font-mono); }
  .featured-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 40px; padding: 36px; align-items: center; }
  .featured-content { min-width: 0; }
  .project-label { color: var(--accent-sage); font: 0.65rem var(--font-mono); letter-spacing: 1px; text-transform: uppercase; margin: 0 0 14px; }
  h3 { font-size: 1.5rem; line-height: 1.25; letter-spacing: -0.6px; margin: 0 0 14px; }
  .featured-content h3 { font-size: 2.8rem; }
  .project-purpose { font-size: 1.1rem; font-weight: 600; margin: 0 0 14px; }
  .featured-desc, .card-desc { font-size: 0.91rem; line-height: 1.8; color: var(--text-muted); margin: 0 0 22px; }
  .project-notes { display: grid; gap: 14px; border-left: 2px solid var(--border); padding-left: 16px; margin: 24px 0; }
  dt { color: var(--primary); font: 0.68rem var(--font-mono); margin-bottom: 4px; }
  dd { color: var(--text-muted); font-size: 0.83rem; margin: 0; line-height: 1.7; }
  .featured-art { margin: 0; border: 1px solid var(--card-border); border-radius: 6px; overflow: hidden; }
  .featured-art img { display: block; width: 100%; height: auto; }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; padding: 12px 16px; background: var(--bg-subtle); color: var(--text-muted); font: 0.65rem var(--font-mono); }
  figcaption span { color: var(--primary); }
  .tags { display: flex; flex-wrap: wrap; gap: 7px; }
  .tags span { font: 0.67rem var(--font-mono); padding: 6px 9px; background: var(--bg-subtle); border: 1px solid var(--card-border); border-radius: 4px; color: var(--text-muted); }
  .technical-details { border-top: 1px solid var(--card-border); }
  summary { cursor: pointer; padding: 16px 22px; display: flex; align-items: center; justify-content: space-between; gap: 16px; font-size: 0.8rem; font-weight: 600; color: var(--primary); list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: var(--bg-subtle); }
  .detail-symbol { margin-right: 10px; font-family: var(--font-mono); }
  .expand-icon { font-size: 1.3rem; font-weight: 400; }
  details[open] .expand-icon { transform: rotate(45deg); }
  .api-demo { padding: 0 24px 24px; min-width: 0; }
  .simulation-note { font-size: 0.8rem; line-height: 1.7; color: var(--text-muted); margin: 0 0 16px; }
  .other-projects { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: start; }
  .project-card { transition: border-color 0.2s ease; }
  .project-card:hover { border-color: var(--primary); }
  .card-content { padding: 28px; }
  .team-note { color: var(--primary); font-size: 0.78rem; margin: -8px 0 20px; }
  .project-highlights { margin: 0; padding: 0 28px 22px 42px; color: var(--text-muted); font-size: 0.85rem; line-height: 2; }
  .project-highlights li::marker { color: var(--accent-sage); }
  @media (max-width: 900px) { .projects-header { grid-template-columns: 1fr; gap: 24px; } .featured-grid { grid-template-columns: 1fr; padding: 24px; gap: 28px; } .featured-art { max-width: 480px; } }
  @media (max-width: 600px) { .projects { padding: 72px 0; } .other-projects { grid-template-columns: 1fr; } .card-content { padding: 22px; } .featured-grid { padding: 22px; } .project-bar { padding: 12px 18px; font-size: 0.65rem; } .api-demo { padding: 0 14px 18px; } }
</style>
