---
const base = `${import.meta.env.BASE_URL}/`;
---

<section data-motion="hero" id="home" class="hero">
  <div class="hero-container">
    <div class="hero-content">
      <p class="eyebrow"><span aria-hidden="true">~/</span> BIENVENUE DANS MON UNIVERS</p>
      <h1>Kaoutar<span>Bendidi<span class="cursor" aria-hidden="true">_</span></span></h1>
      <p class="hero-role">Élève ingénieure en informatique<br /><span>Développement Full Stack</span></p>
      <p class="description">Je développe des applications web et j’explore les systèmes qui les font fonctionner. Du modèle de données à l’interface, j’apprends en construisant.</p>
      <div class="buttons">
        <a href="#projects" class="primary">Explorer mes projets <span aria-hidden="true">↗</span></a>
        <a href={`${base}cv-kaoutar-bendidi.pdf`} class="secondary" download>Télécharger mon CV <span aria-hidden="true">↓</span></a>
        <a href="#contact" class="contact-shortcut">Me contacter <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="workspace" aria-label="Mon profil sous forme de code">
      <div class="workspace-title"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>kaoutar / workspace</span><span aria-hidden="true">⌘</span></div>
      <div class="workspace-tabs"><span class="active-tab"><span class="ts-badge">TS</span> profil.ts</span><a href="#projects">projets/ <span aria-hidden="true">↗</span></a></div>
      <div class="editor">
        <div class="line-numbers" aria-hidden="true">{Array.from({length: 18}, (_, i) => <span>{i + 1}</span>)}</div>
        <pre tabindex="0" aria-label="Profil TypeScript"><code><span class="comment">// Apprendre. Construire. Itérer.</span>
<span class="keyword">const</span> <span class="variable">profil</span> = &#123;
  <span class="property">nom</span>: <span class="string">"Kaoutar Bendidi"</span>,
  <span class="property">formation</span>: <span class="string">"Génie informatique"</span>,
  <span class="property">année</span>: <span class="number">4</span>,
  <span class="property">focus</span>: <span class="string">"Full Stack · DevOps · DevSecOps"</span>,
  <span class="property">stack</span>: &#123;
    <span class="property">front</span>: <span class="string">"JavaScript · Tailwind · Vue"</span>,
    <span class="property">back</span>: <span class="string">"Java · JavaScript · Prisma · Node.js · Express.js · PHP"</span>,
    <span class="property">data</span>: <span class="string">"PostgreSQL"</span>
  &#125;,
  <span class="property">apprentissage</span>: [
    <span class="string">"Design Patterns"</span>,
    <span class="string">"Administration systèmes"</span>
  ],
  <span class="property">recherche</span>: <span class="string">"Stage"</span>
&#125; <span class="keyword">as const</span>;
<span class="comment">// La suite se construit en projets.</span></code></pre>
      </div>
      <div class="terminal"><p><span aria-hidden="true">❯</span> découvrir mes réalisations</p><a href="#projects">Ouvrir les projets <span aria-hidden="true">↗</span></a></div>
      <div class="workspace-status"><span>⑂ main</span><span>TypeScript <span aria-hidden="true">·</span> UTF-8</span></div>
    </div>
  </div>
  <div class="hero-footer"><span><i aria-hidden="true"></i> À la recherche d’un stage</span><a href="#about">Découvrir mon parcours <span aria-hidden="true">↓</span></a></div>
</section>

<style>
  .hero { padding: clamp(52px, 8vw, 100px) 0 0; background-image: linear-gradient(var(--grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--grid-line) 1px, transparent 1px); background-size: 40px 40px; }
  .hero-container { width: min(1180px, 92%); margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  .eyebrow { color: var(--primary); font: 0.75rem var(--font-mono); margin: 0 0 28px; }
  .eyebrow > span { color: var(--accent-sage); margin-right: 8px; }
  .hello { color: var(--text-muted); margin: 0 0 10px; font-size: 1rem; }
  h1 { margin: 0 0 24px; font-size: clamp(3.4rem, 6.5vw, 5.7rem); line-height: 1.03; letter-spacing: -0.065em; font-weight: 800; }
  h1 > span { display: block; color: var(--primary); }
  .cursor { color: var(--accent-sage); font-weight: 500; }
  .hero-role { font-size: clamp(1rem, 1.5vw, 1.15rem); line-height: 1.7; font-weight: 600; margin: 0 0 20px; }
  .hero-role span { color: var(--text-muted); font-weight: 400; }
  .description { color: var(--text-muted); max-width: 480px; font-size: 0.98rem; line-height: 1.85; }
  .buttons { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .buttons a { padding: 13px 18px; border: 1px solid var(--border); border-radius: 7px; font-size: 0.83rem; font-weight: 600; display: inline-flex; align-items: center; gap: 14px; }
  .buttons .primary { background: var(--primary); border-color: var(--primary); color: var(--on-primary); }
  .primary:hover { background: var(--primary-hover); }
  .secondary { background: var(--card); }
  .secondary:hover, .contact-shortcut:hover { border-color: var(--primary); color: var(--primary); }
  .contact-shortcut { background: var(--bg-subtle); color: var(--text-main); }
  .workspace { min-width: 0; background: #101724; color: #d9e2f2; border: 1px solid #303b50; border-radius: 10px; overflow: hidden; font-family: var(--font-mono); box-shadow: 0 24px 70px -25px #14244460; transform: rotate(1deg); }
  .workspace-title { display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; font-size: 0.65rem; color: #99a8be; background: #182131; border-bottom: 1px solid #2b3547; }
  .window-dots { display: flex; gap: 5px; }
  .window-dots i { width: 7px; height: 7px; border-radius: 50%; background: #526179; }
  .window-dots i:first-child { background: #b598ee; }
  .workspace-tabs { display: flex; border-bottom: 1px solid #2b3547; font-size: 0.72rem; }
  .workspace-tabs > * { display: flex; gap: 8px; align-items: center; padding: 13px 18px; }
  .active-tab { border-top: 2px solid #b598ee; border-right: 1px solid #2b3547; }
  .workspace-tabs a { color: #9eacc3; }
  .workspace-tabs a:hover { color: #e1d3ff; background: #1d293c; }
  .ts-badge { color: #8cbcff; font-size: 0.65rem; font-weight: 700; }
  .editor { display: flex; padding: 24px 0; font-size: 0.74rem; line-height: 1.95; }
  .line-numbers { display: flex; flex-direction: column; padding: 0 14px 0 18px; color: #65748b; text-align: right; user-select: none; }
  pre { margin: 0; padding-right: 20px; min-width: 0; overflow-x: auto; font: inherit; }
  code { font: inherit; }
  .comment { color: #96a4ba; } .keyword { color: #c8a9ff; } .variable { color: #a8cfff; } .property { color: #d9e2f2; } .string { color: #8ee0c1; } .number { color: #f4c48a; }
  .terminal { padding: 16px 20px; border-top: 1px solid #2b3547; background: #131c2b; font-size: 0.7rem; }
  .terminal p { margin: 0 0 10px; color: #aab7ca; } .terminal p span { color: #8ee0c1; margin-right: 8px; }
  .terminal a { color: #ceb4ff; text-decoration: underline; text-underline-offset: 4px; }
  .workspace-status { display: flex; justify-content: space-between; gap: 12px; padding: 8px 16px; font-size: 0.62rem; color: #a9b9d0; background: #1e2b40; }
  .hero-footer { width: min(1180px, 92%); margin: 64px auto 0; padding: 22px 0; border-top: 1px solid var(--border); display: flex; justify-content: space-between; gap: 18px; flex-wrap: wrap; font: 0.72rem var(--font-mono); color: var(--text-muted); }
  .hero-footer > span { display: flex; align-items: center; gap: 8px; } .hero-footer i { width: 6px; height: 6px; background: var(--accent-sage); border-radius: 50%; }
  .hero-footer a:hover { color: var(--primary); }
  @media (max-width: 900px) { .hero-container { grid-template-columns: 1fr; gap: 40px; } .workspace { transform: none; width: 100%; max-width: 650px; } .description { max-width: 580px; } .hero-footer { margin-top: 40px; } }
  @media (max-width: 480px) {
    .hero { padding-top: 38px; background-size: 32px 32px; }
    .hero-container { width: min(100% - 32px, 440px); gap: 28px; }
    .eyebrow { margin-bottom: 18px; font-size: 0.78rem; }
    .hello { margin-bottom: 6px; }
    h1 { margin-bottom: 18px; font-size: clamp(2.8rem, 13vw, 3.7rem); }
    .hero-role { margin-bottom: 14px; line-height: 1.55; }
    .description { margin: 0; font-size: 0.94rem; line-height: 1.7; }
    .buttons { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 22px; }
    .buttons a { min-height: 46px; justify-content: space-between; padding: 11px 13px; font-size: 0.78rem; gap: 8px; }
    .buttons .primary { grid-column: 1 / -1; }
    .workspace { border-radius: 9px; }
    .workspace-title { padding: 11px 13px; font-size: 0.7rem; }
    .workspace-tabs { font-size: 0.73rem; }
    .workspace-tabs > * { padding: 11px 14px; }
    .editor { padding: 16px 0; font-size: 0.72rem; line-height: 1.62; }
    .line-numbers { padding-left: 10px; padding-right: 10px; }
    pre { padding-right: 14px; }
    .terminal { padding: 12px 16px; font-size: 0.72rem; }
    .terminal p { margin-bottom: 6px; }
    .workspace-status { padding: 7px 13px; font-size: 0.68rem; }
    .hero-footer { width: calc(100% - 32px); margin-top: 28px; padding: 18px 0; font-size: 0.74rem; }
  }
</style>
