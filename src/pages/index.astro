---
import "../styles/global.css";
import "../styles/scroll-motion.css";

import Navbar from "../components/navbar.astro";
import Hero from "../components/hero.astro";
import About from "../components/about.astro";
import Skills from "../components/skills.astro";
import Projects from "../components/projects.astro";
import Contact from "../components/contact.astro";
import Footer from "../components/footer.astro";
const base = `${import.meta.env.BASE_URL}/`;
---

<html lang="fr" data-dev-mode="true">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <link rel="icon" href={`${base}favicon.svg`} />

    <title>Kaoutar Bendidi — Élève ingénieure en informatique</title>
    <meta
      name="description"
      content="Portfolio de Kaoutar Bendidi, élève ingénieure en génie informatique. Conception logicielle, architectures Full Stack et expériences web interactives."
    />

    <!-- Google Fonts: Plus Jakarta Sans pour la modernité et l'élégance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Prévention de flash de thème -->
    <script is:inline>
      document.documentElement.classList.add("js");
      let savedMode = null;
      try {
        savedMode = localStorage.getItem("kaoutar_portfolio_mode");
      } catch (e) {}
      if (savedMode === "visual") {
        document.documentElement.removeAttribute("data-dev-mode");
      }
    </script>

    <script>
      import "../scripts/scroll-motion";
    </script>
  </head>

  <body>
    <a href="#main-content" class="skip-link">Aller au contenu</a>
    <!-- 1. Navigation et choix du thème -->
    <Navbar />

    <main id="main-content">
      <!-- 2. Présentation et profil TypeScript -->
      <Hero />

      <!-- 3. À propos : Profil, Vision & 3 piliers d'ingénierie -->
      <About />

      <!-- 4. Technologies & Architecture logicielle -->
      <Skills />

      <!-- 5. Réalisations majeures (Dishly avec banc d'essai API, Muestra, Sehati, Studio Génératif, Budget App) -->
      <Projects />

      <!-- 6. Contact -->
      <Contact />
    </main>

    <!-- 8. Footer -->
    <Footer />
  </body>
</html>
