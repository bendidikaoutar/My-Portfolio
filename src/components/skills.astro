---
import ArchitectureFlow from "./ArchitectureFlow.astro";

---

<section id="skills" class="skills">
  <div class="container">

    <div class="skills-topbar">
      <div class="section-index">
        <span>03</span>
        <span class="line"></span>
        <p>Stack & Architecture</p>
      </div>

      <div class="skills-header-grid">
        <h2>
          Ma boîte à outils.<br />
          <span>Du code au déploiement.</span>
        </h2>

        <p class="skills-lead">
          Les technologies que je mets en pratique dans mes projets, et les outils que j’explore pour aller plus loin. Le schéma ci-dessous permet de suivre le trajet d’une requête à travers une application.
        </p>
      </div>
    </div>

    <!-- Live Interactive Full Stack Architecture Pipeline -->
    <div class="arch-section" data-motion="architecture">
      <ArchitectureFlow />
    </div>

    <!-- Categorized Skill Matrix -->
    <div class="skills-list">

      <div class="skill-row">
        <span class="number">01</span>
        <div class="skill-meta">
          <h3>Frontend</h3>
          <a class="skill-subtitle" href="#project-dishly">En pratique · Dishly ↗</a>
        </div>
        <div class="tags">
          <span>React 19</span>
          <span>TypeScript</span>
          <span>Next.js</span>
          <span>Astro</span>
          <span>Tailwind CSS</span>
          <span>HTML5 / Semantic</span>
          <span>CSS Modulaire</span>
          <span>State Management</span>
        </div>
      </div>

      <div class="skill-row">
        <span class="number">02</span>
        <div class="skill-meta">
          <h3>Backend</h3>
          <a class="skill-subtitle" href="#project-dishly">API & données · Dishly ↗</a>
        </div>
        <div class="tags">
          <span>Node.js</span>
          <span>Express</span>
          <span>Prisma ORM</span>
          <span>RESTful APIs</span>
          <span>Auth & JWT</span>
          <span>Middleware Architecture</span>
        </div>
      </div>

      <div class="skill-row">
        <span class="number">03</span>
        <div class="skill-meta">
          <h3>Database</h3>
          <a class="skill-subtitle" href="#project-sehati">Modélisation · Sehati ↗</a>
        </div>
        <div class="tags">
          <span>PostgreSQL</span>
          <span>SQL</span>
          <span>MySQL</span>
          <span>Schema Migrations</span>
          <span>Relations & Indexation</span>
        </div>
      </div>

      <div class="skill-row">
        <span class="number">04</span>
        <div class="skill-meta">
          <h3>DevOps & QA</h3>
          <span class="skill-subtitle">CI/CD en projet · Docker en apprentissage</span>
        </div>
        <div class="tags">
          <span>Git & GitHub Flow</span>
          <span>GitHub Actions (CI/CD)</span>
          <span>Docker Basics</span>
          <span>Postman / Thunder</span>
          <span>Linux CLI</span>
          <span>Swagger / OpenAPI</span>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .skills {
    padding: 130px 0;
    background: var(--bg-subtle);
    color: var(--text-main);
    border-block: 1px solid var(--border);
  }

  .container {
    width: min(1140px, 92%);
    margin: 0 auto;
  }

  .skills-topbar {
    margin-bottom: 50px;
  }

  .section-index {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }

  .section-index span:first-child {
    font-family: var(--font-sans);
    color: var(--accent-sage);
  }

  .line {
    width: 42px;
    height: 1px;
    background: var(--accent-sage);
  }

  .section-index p {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-sage);
  }

  .skills-header-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: end;
  }

  h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 3.3rem);
    line-height: 1.15;
    letter-spacing: -2px;
    color: var(--text-main);
  }

  .skills-lead {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-muted);
    max-width: 500px;
  }

  .arch-section {
    margin-bottom: 40px;
  }

  /* LIST */

  .skills-list {
    border-top: 1px solid var(--border);
  }

  .skill-row {
    display: grid;
    grid-template-columns: 50px 200px 1fr;
    gap: 24px;
    padding: 28px 0;
    align-items: start;
    border-bottom: 1px solid var(--border);
    transition: padding-left 0.25s ease, background 0.25s ease;
  }

  .skill-row:hover {
    padding-left: 10px;
    background: var(--card);
  }

  .number {
    color: var(--accent-sage);
    font-size: 0.78rem;
    font-weight: 700;
    padding-top: 4px;
    font-family: var(--font-sans);
  }

  .skill-meta h3 {
    margin: 0 0 4px;
    font-family: var(--font-sans);
    font-size: 1.35rem;
    color: var(--text-main);
  }

  .skill-subtitle {
    font-size: 0.72rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--accent-sage);
    font-weight: 600;
  }

  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tags span {
    border: 1px solid var(--border);
    padding: 7px 13px;
    border-radius: 5px;
    font-size: 0.78rem;
    color: var(--text-muted);
    background: var(--card);
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
  }

  .tags span:hover {
    background: var(--accent-sage);
    color: #fff;
    border-color: var(--accent-sage);
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .skills {
      padding: 90px 0;
    }

    .skills-header-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .skill-row {
      grid-template-columns: 40px 1fr;
    }

    .tags {
      grid-column: 2;
      margin-top: 8px;
    }
  }

  @media (max-width: 520px) {
    .skills {
      padding: 75px 0;
    }

    .skill-row {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 22px 0;
    }

    .number, .tags {
      grid-column: auto;
    }

    .tags span {
      font-size: 0.72rem;
      padding: 6px 10px;
    }
  }
  h2 span { color: var(--primary); }
  .skill-subtitle[href]:hover { text-decoration: underline; text-underline-offset: 4px; }
</style>
