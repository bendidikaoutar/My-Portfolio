                <h4>Typecheck TypeScript</h4>
                <span class="step-duration">2.4s · Strict Mode OK</span>
              </div>
            </div>

            <div class="ci-step passed" id="step-test">
              <div class="step-status-icon">✓</div>
              <div class="step-meta">
                <span class="step-order">Job 3</span>
                <h4>Tests d'Intégration</h4>
                <span class="step-duration">3.1s · 18 tests validés</span>
              </div>
            </div>

            <div class="ci-step passed" id="step-build">
              <div class="step-status-icon">✓</div>
              <div class="step-meta">
                <span class="step-order">Job 4</span>
                <h4>Build Conteneur Docker</h4>
                <span class="step-duration">4.8s · Image optimisée</span>
