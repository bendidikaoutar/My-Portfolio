<script>
  const aboutSection = document.getElementById("about");
  const typewriter = document.getElementById("about-typewriter");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const isMobile = window.matchMedia("(max-width: 580px)").matches;
  let hasTyped = false;

  function typeHeading() {
    if (hasTyped || !typewriter) return;
    hasTyped = true;

    const text = typewriter.dataset.text || typewriter.textContent || "";
    if (reducedMotion) {
      typewriter.textContent = text;
      return;
    }

    typewriter.textContent = "";
    let index = 0;

    function writeNextCharacter() {
      if (!typewriter || index >= text.length) return;
      typewriter.textContent += text[index];
      index += 1;
      window.setTimeout(writeNextCharacter, isMobile ? 30 : 48);
    }

    window.setTimeout(writeNextCharacter, 180);
  }

  if (aboutSection && !reducedMotion) {
    const revealItems = aboutSection.querySelectorAll<HTMLElement>(".about-reveal");
    let hasScheduledUpdate = false;

    function updateScrollProgress() {
      const viewportHeight = window.innerHeight;
      const start = viewportHeight * 0.92;
      const end = viewportHeight * 0.38;

      revealItems.forEach((item) => {
        const itemTop = item.getBoundingClientRect().top;
        const progress = Math.min(1, Math.max(0, (start - itemTop) / (start - end)));
        item.style.setProperty("--scroll-progress", progress.toFixed(3));
        item.style.setProperty("--scroll-offset", `${((1 - progress) * 36).toFixed(1)}px`);
      });

      if (aboutSection.getBoundingClientRect().top < viewportHeight * 0.82) {
        typeHeading();
      }
    }

    function scheduleUpdate() {
      if (hasScheduledUpdate) return;
      hasScheduledUpdate = true;
      window.requestAnimationFrame(() => {
        updateScrollProgress();
        hasScheduledUpdate = false;
      });
    }

    aboutSection.classList.add("about-scroll-active");
    updateScrollProgress();
    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("resize", scheduleUpdate, { passive: true });
  } else {
    typeHeading();
  }
</script>

