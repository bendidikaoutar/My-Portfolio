---
// ProjectLab.astro - Laboratoire Interactif des Projets Réels de Kaoutar
// Remplace CodeToLife avec des simulateurs authentiques de ses vrais projets (Dishly, Studio Génératif, CI/CD)
---

<section id="project-lab" class="lab-section reveal">
  <div class="container">

    <!-- Section Header -->
    <div class="lab-header reveal-item reveal-delay-1">
      <div class="section-tag">
        <span class="tag-num">04</span>
        <span class="tag-title">LABORATOIRE INTERACTIF</span>
      </div>

      <div class="header-grid">
        <h2>
          Des projets réels,<br />
          <span class="gradient-text">testables en direct.</span>
        </h2>
        <p class="lab-lead">
          Pas de captures trompeuses ni d'artifices : interagissez directement avec la logique, les données et les algorithmes qui animent mes applications.
        </p>
      </div>

      <!-- Tab Selectors -->
      <div class="lab-tabs" role="tablist" aria-label="Simulateurs de projets">
        <button type="button" class="tab-btn active" data-tab="dishly" role="tab" aria-selected="true">
          <span class="tab-icon">🍳</span>
          <span class="tab-name">Dishly : Flux Full Stack</span>
          <span class="tab-badge">API & Données</span>
        </button>

        <button type="button" class="tab-btn" data-tab="generative" role="tab" aria-selected="false">
          <span class="tab-icon">🎨</span>
          <span class="tab-name">Studio Génératif : Algorithmes</span>
          <span class="tab-badge">Maths & Canvas</span>
        </button>

        <button type="button" class="tab-btn" data-tab="devops" role="tab" aria-selected="false">
          <span class="tab-icon">⚡</span>
          <span class="tab-name">Pipeline CI/CD : Déploiement</span>
          <span class="tab-badge">DevOps & QA</span>
        </button>
      </div>
    </div>

    <!-- TAB 1: DISHLY FULL STACK DATA SIMULATOR -->
    <div class="tab-panel active" id="panel-dishly" role="tabpanel">
      <div class="lab-grid">
        
        <!-- Left: Code & Controls -->
        <div class="lab-card code-workbench">
          <div class="workbench-header">
            <div class="window-dots" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
            <div class="view-switchers">
              <button type="button" class="view-pill active" data-view="controller">recipeController.ts</button>
              <button type="button" class="view-pill" data-view="schema">schema.prisma</button>
            </div>
            <span class="tech-badge">Node.js · Prisma</span>
          </div>

          <!-- Query Presets -->
          <div class="preset-bar">
            <span class="preset-label">Requête :</span>
            <div class="preset-buttons">
              <button type="button" class="preset-btn active" data-recipe="tajine">Tajine Traditionnel</button>
              <button type="button" class="preset-btn" data-recipe="quinoa">Bowl Énergie Quinoa</button>
              <button type="button" class="preset-btn" data-recipe="citrus">Salade Citrus & Avocat</button>
            </div>
          </div>

          <!-- Code Display -->
          <div class="code-viewport">
            <pre class="code-block" id="dishly-code"><code>// Sélection de données via Prisma ORM
const recipe = await prisma.recipe.findUnique(&#123;
  where: &#123; slug: "tajine-traditionnel" &#125;,
  include: &#123;
    ingredients: true,
    nutrients: true,
    author: &#123; select: &#123; name: true, role: true &#125; &#125;
  &#125;
&#125;);
res.status(200).json(&#123; success: true, data: recipe &#125;);</code></pre>
          </div>

          <div class="workbench-footer">
            <div class="metric-item">
              <span class="m-lbl">Latence API :</span>
              <span class="m-val success" id="dishly-latency">18ms</span>
            </div>
            <div class="metric-item">
              <span class="m-lbl">Status :</span>
              <span class="m-val success">200 OK</span>
            </div>
            <div class="metric-item">
              <span class="m-lbl">Pool SQL :</span>
              <span class="m-val">PostgreSQL actif</span>
            </div>
          </div>
        </div>

        <!-- Right: Real Dynamic UI Render -->
        <div class="lab-card render-workbench">
          <div class="workbench-header">
            <span class="render-title">Rendu Réactif de l'Interface</span>
            <span class="live-status">● CONNECTÉ AU BACKEND</span>
          </div>

          <div class="render-body">
            <!-- Sleek Pure CSS Dynamic Card (Authentic data, no fake stock photos) -->
            <div class="recipe-dynamic-card">
              <div class="card-hero-banner" id="dishly-banner">
                <div class="recipe-icon-circle" id="dishly-icon">🍲</div>
                <div class="hero-labels">
                  <span class="badge-time" id="dishly-time">⏱️ 35 min</span>
                  <span class="badge-category" id="dishly-cat">Traditionnel & Mijoté</span>
                </div>
              </div>

              <div class="recipe-card-content">
                <div class="title-row">
                  <div>
                    <h3 class="recipe-name" id="dishly-title">Tajine d'Agneau aux Pruneaux</h3>
                    <p class="recipe-desc" id="dishly-desc">Mijoté aux épices douces marocaines, oignons caramélisés et amandes torréfiées.</p>
                  </div>
                  <button type="button" class="fav-btn" id="dishly-fav-btn" aria-label="Ajouter aux favoris">
                    <span id="fav-icon">🤍</span>
                  </button>
                </div>

                <!-- Structured Data Chips -->
                <div class="recipe-meta-grid">
                  <div class="meta-box">
                    <span class="meta-title">Portions</span>
                    <strong id="dishly-servings">4 pers.</strong>
                  </div>
                  <div class="meta-box">
